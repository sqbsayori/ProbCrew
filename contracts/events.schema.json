{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://probcrew/contracts/events.schema.json",
  "title": "Agent 运行时事件协议",
  "description": "后端 Agent 运行时 → 前端的唯一契约。SSE 以 `data: <本对象 JSON>` 单行传输。前端必须忽略未知 type（保证向后兼容）。字段随 type 取用，未用到的字段不应出现在报文中（后端已 exclude_none）。",
  "type": "object",
  "required": ["type", "ts"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "run.start",
        "context.received",
        "plan",
        "agent.start",
        "agent.delta",
        "agent.end",
        "tool.call",
        "tool.result",
        "artifact",
        "verification.report",
        "hitl.request",
        "hitl.resolved",
        "run.end",
        "error"
      ]
    },
    "ts": { "type": "number", "description": "epoch 秒" },
    "run_id": { "type": ["string", "null"] },
    "agent": { "type": ["string", "null"], "description": "Agent id，见 /api/agents" },
    "label": { "type": ["string", "null"], "description": "Agent 中文名" },
    "session_id": { "type": ["string", "null"] },
    "query": { "type": ["string", "null"] },
    "intent": {
      "type": ["string", "null"],
      "enum": ["knowledge", "solve", "visualize", "analytics", "animation", "multi", null]
    },
    "step": { "type": ["integer", "null"] },
    "steps": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "agent": { "type": "string" },
          "label": { "type": "string" }
        }
      },
      "description": "plan 事件：本次要唤醒的 Agent 列表"
    },
    "reason": { "type": ["string", "null"], "description": "plan 事件：路由理由" },
    "ok": { "type": ["boolean", "null"] },
    "duration_ms": { "type": ["integer", "null"] },
    "summary": { "type": ["string", "null"] },
    "text": { "type": ["string", "null"], "description": "agent.delta 的增量文本" },
    "tool": { "type": ["string", "null"] },
    "args": { "type": ["object", "null"] },
    "data": { "type": ["object", "null"] },
    "kind": {
      "type": ["string", "null"],
      "enum": ["animation", "chart", "formula", "steps", "text", "table", null]
    },
    "payload": { "type": ["object", "null"], "description": "artifact 内容，结构随 kind 而定" },
    "hitl_id": { "type": ["string", "null"] },
    "draft": { "type": ["string", "null"], "description": "hitl.request：待确认草稿" },
    "options": {
      "type": ["array", "null"],
      "items": { "type": "string", "enum": ["confirm", "correct", "supplement"] }
    },
    "action": {
      "type": ["string", "null"],
      "enum": ["confirm", "correct", "supplement", null]
    },
    "final": { "type": ["string", "null"] },
    "status": { "type": ["string", "null"] },
    "message": { "type": ["string", "null"] },
    "final_answer": {
      "type": ["string", "null"],
      "description": "run.end 携带：聚合后的最终答案（Markdown + LaTeX）"
    }
  },
  "additionalProperties": false,

  "definitions": {
    "artifactPayload": {
      "description": "artifact 的 payload 结构。新增 kind 属于向后兼容扩展。",
      "oneOf": [
        {
          "title": "animation",
          "type": "object",
          "required": ["id", "title", "url"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "url": { "type": "string" },
            "category": { "type": "string" },
            "description": { "type": "string" },
            "reason": { "type": "string" },
            "controls": { "type": "object" }
          }
        },
        {
          "title": "formula",
          "type": "object",
          "required": ["items"],
          "properties": {
            "title": { "type": "string" },
            "items": { "type": "array", "items": { "type": "string" }, "description": "LaTeX 源串数组" }
          }
        },
        {
          "title": "steps",
          "type": "object",
          "required": ["steps"],
          "properties": {
            "title": { "type": "string" },
            "count": { "type": "integer" },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["index", "title", "body"],
                "properties": {
                  "index": { "type": "integer" },
                  "title": { "type": "string" },
                  "body": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "title": "chart",
          "type": "object",
          "required": ["pdf", "cdf"],
          "properties": {
            "title": { "type": "string" },
            "dist": { "type": "string" },
            "name": { "type": "string" },
            "kind": { "type": "string", "enum": ["discrete", "continuous"] },
            "params": { "type": "object" },
            "mean": { "type": "number" },
            "var": { "type": "number" },
            "std": { "type": "number" },
            "note": { "type": "string" },
            "pdf": { "$ref": "#/definitions/series" },
            "cdf": { "$ref": "#/definitions/series" }
          }
        },
        {
          "title": "table",
          "type": "object",
          "required": ["columns", "rows"],
          "properties": {
            "title": { "type": "string" },
            "columns": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "array" } }
          }
        },
        {
          "title": "text",
          "type": "object",
          "required": ["content"],
          "properties": { "content": { "type": "string" } }
        }
      ]
    },
    "series": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "array", "items": { "type": "number" } },
        "y": { "type": "array", "items": { "type": "number" } }
      }
    }
  },

  "examples": [
    {
      "type": "run.start",
      "ts": 1786000000.1,
      "run_id": "run_ab12cd34",
      "session_id": "web_9f3a",
      "query": "这段什么意思？"
    },
    {
      "type": "context.received",
      "ts": 1786000000.2,
      "run_id": "run_ab12cd34",
      "summary": "已读取 《1.4 全概率公式与贝叶斯公式》、5171 字、13 个公式、已选中 41 字、含视频进度、跨 2 个框架",
      "data": {
        "title": "1.4 全概率公式与贝叶斯公式",
        "chars": 5171,
        "selection_chars": 41,
        "formula_count": 13,
        "frame_count": 2,
        "has_media": true,
        "outline": "- 1.4 全概率公式与贝叶斯公式\n  - 全概率公式\n  - 贝叶斯公式"
      }
    },
    {
      "type": "plan",
      "ts": 1786000000.4,
      "run_id": "run_ab12cd34",
      "intent": "multi",
      "steps": [
        { "agent": "visualizer", "label": "Visualization Agent 分布可视化" },
        { "agent": "knowledge", "label": "Knowledge Agent 知识讲解" },
        { "agent": "solver", "label": "Problem Solver 题目讲解" }
      ],
      "reason": "同时命中 visualize/solve 多个领域，并行调度 3 个 Agent"
    },
    {
      "type": "tool.result",
      "ts": 1786000000.6,
      "run_id": "run_ab12cd34",
      "tool": "kb_search",
      "ok": true,
      "duration_ms": 12,
      "data": { "hit_count": 2, "empty": false }
    },
    {
      "type": "verification.report",
      "ts": 1786000001.9,
      "run_id": "run_ab12cd34",
      "ok": true,
      "summary": "已通过数值重算验证",
      "data": {
        "level": "A",
        "levelLabel": "已通过数值重算验证",
        "passed": true,
        "checks": [
          {
            "name": "数值重算",
            "passed": true,
            "method": "sympy_recompute",
            "detail": "SymPy 独立计算 P(D)=0.0345，与解答一致"
          }
        ],
        "confidence": 1.0
      }
    },
    {
      "type": "artifact",
      "ts": 1786000001.2,
      "run_id": "run_ab12cd34",
      "kind": "formula",
      "payload": {
        "title": "关键公式",
        "items": ["P(A)=\\sum_{i=1}^{n}P(B_i)P(A\\mid B_i)"]
      }
    },
    {
      "type": "hitl.request",
      "ts": 1786000002.1,
      "run_id": "run_ab12cd34",
      "agent": "verifier",
      "hitl_id": "run_ab12cd34",
      "draft": "以上解题结论属于关键结论，按流程需你确认后才能作为最终答案。",
      "options": ["confirm", "correct", "supplement"]
    },
    {
      "type": "run.end",
      "ts": 1786000003.0,
      "run_id": "run_ab12cd34",
      "status": "ok",
      "final_answer": "## 结论\n\n$$P(D)=0.0345$$"
    },
    {
      "type": "error",
      "ts": 1786000004.0,
      "run_id": "run_ab12cd34",
      "agent": "visualizer",
      "message": "符号推导失败：不支持的分布 key"
    }
  ]
}
