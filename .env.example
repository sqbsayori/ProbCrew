# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000

# ===== LLM =====
# auto   = 有 DEEPSEEK_API_KEY 就用真模型，没有则自动降级 mock（推荐）
# deepseek = 强制真模型（没 Key 会报错，适合验收时确认自己真的在调模型）
# mock   = 强制确定性假模型（离线演示 / CI / 无网络）
LLM_PROVIDER=auto

DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_S=60

# ===== 协作机制开关（演示时可以现场开关，效果很直观）=====
HITL_ENABLED=true        # 人机协同闸门（LangGraph interrupt）
VERIFY_ENABLED=true      # 生成/验证分权

# ===== 演示友好项 =====
MOCK_DELAY_MS=18         # mock 流式片段间隔，让协作轨迹动起来

# ===== 迭代二：基础设施（当前代码未使用，先占位）=====
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# POSTGRES_DSN=postgresql://admin:admin@localhost:5432/probstat
# REDIS_URL=redis://localhost:6379/0
# JWT_SECRET=change-me-in-production
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key

# ===== 检索后端切换开关（P2 预留）=====
# KB_BACKEND=local        # local | qdrant
