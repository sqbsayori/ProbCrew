# ===== 服务（部署无关化的关键：换机器只改这里，不改代码）=====
# 本地默认：只监听本机。想让局域网/服务器访问就改成 0.0.0.0
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS 白名单：逗号分隔，多个来源写成 https://a.example.edu,https://b.example.edu
# 默认 `*`（仅适合本地/内网演示）；对外部署前**必须**收窄。
CORS_ORIGINS=*
# 需要跨域带 Cookie 时才打开；`*` 与它同时存在不会生效（浏览器规则）
CORS_ALLOW_CREDENTIALS=false

# ===== 存储（L2 敏感数据的落点，永远不进仓库）=====
# 相对路径按仓库根解析；也可以直接给 DB_URL=sqlite:///绝对路径
DB_PATH=backend/data/learning.sqlite
# DB_URL=

# ===== LLM =====
# auto   = 有 DEEPSEEK_API_KEY 就用真模型，没有则自动降级 mock（推荐）
# deepseek = 强制真模型（没 Key 会报错，适合验收时确认自己真的在调模型）
# mock   = 强制确定性假模型（离线演示 / CI / 无网络）
LLM_PROVIDER=auto

DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_S=60

# ===== 协作机制开关（演示时可以现场开关，效果很直观）=====
HITL_ENABLED=true        # 人机协同闸门（LangGraph interrupt）
VERIFY_ENABLED=true      # 生成/验证分权

# ===== 演示友好项 =====
MOCK_DELAY_MS=18         # mock 流式片段间隔，让协作轨迹动起来

# ===== 检索升级（M2）：混合检索 = BM25 + 向量 + 重排 =====
# auto = BM25 + 向量（有重排权重就再重排）；bm25 = 只走词法（排障/对照用）
KB_BACKEND=auto
# 语料两来源：仓库内示例语料（backend/knowledge_base/，L0）
#          + 仓库外正式教材（CORPUS_DIR，L1，该目录已被 .gitignore 覆盖）
# 教材转成 Markdown（保留 # chXX / ## 小节）丢进 CORPUS_DIR 即可，不用改代码。
CORPUS_DIR=backend/data/corpus
# 中文嵌入 / 重排模型。**默认只读本地权重、不联网下载**（数据不出校）。
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 模型权重根目录：留空 = 用 HF 默认缓存（~/.cache/huggingface/hub）。
# 推荐用 scripts/setup_models.py 装到仓库内（但已 gitignore）：
#     MODELS_DIR=backend/data/models
MODELS_DIR=
# 允许首次联网下载权重吗？默认 false：CI 与校内机器都不联网。
# 需要下载时临时设 true 装一次，装完改回 false。
ALLOW_MODEL_DOWNLOAD=false
# 向量候选上限 / 余弦下限；换成真正的 BGE 后建议把下限提到 0.3~0.5
VECTOR_CANDIDATES=12
EMBEDDING_MIN_SCORE=0.08

# ===== 迭代二：基础设施（当前代码未使用，先占位）=====
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# POSTGRES_DSN=postgresql://admin:admin@localhost:5432/probstat
# REDIS_URL=redis://localhost:6379/0
# JWT_SECRET=change-me-in-production
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key

# ===== 向量库（P2 预留：目前向量在进程内，无需外部服务）=====
# KB_VECTOR_STORE=memory   # memory | qdrant
